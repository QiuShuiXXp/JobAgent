# JobAgent 配置示例：复制为 .env 后按需填写（.env 不入库）。
# 桌面形态不读这份文件——配置在 %LOCALAPPDATA%\JobAgent\config.env，密钥进 Windows 凭据管理器，
# LLM key 也可以直接在页面「模型设置」里填。这里只服务于 dev 形态（仓库里跑后端、浏览器开页面）。

# ===== 应用 =====
APP_HOST=127.0.0.1
# 桌面壳固定连 8712；dev 想另开端口避免和桌面版打架可改（如 8001）
APP_PORT=8712

# ===== 数据库（可选）=====
# 留空默认本地 SQLite：dev 落仓库根 jobagent.db，桌面落运行目录
# DATA_BASE_URL=sqlite+aiosqlite:///D:/path/to/dev.db

# ===== LLM=====
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# ===== 平台 =====
PLATFORM_BASE_URL=https://www.zhipin.com

# ===== 可选 =====
# LOG_LEVEL=INFO
# STORAGE_ROOT=./storage          # 简历文件与浏览器 profile 的落盘根
# SESSION_TIMEOUT_MINUTES=60      # 会话超时（引擎重置运行态）
# GREET_DRY_RUN=true              # 打招呼演练：只导航定位不真发消息；真实发送设 false
# BROWSER_HEADLESS=false          # 仅 dev：后端自拉的 Chrome 是否无头
# BROWSER_PATH=                   # 仅 dev：留空自动探测（内置 → 系统 Chrome → Edge）
# QIANFAN_API_KEY=                # 知识问答走百度千帆 AI 搜索 MCP，不配则该能力不可用